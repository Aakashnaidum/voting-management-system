<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Voting Management System</title>
  <link rel="stylesheet" href="${pageContext.request.contextPath}/static/style.css">
</head>
<body>
<header><nav>
  <a class="brand" href="${pageContext.request.contextPath}/">Voting Management System</a>
  <c:choose>
    <c:when test="${not empty sessionScope.sessionUser}">
      <span class="muted">Signed in as <c:out value="${sessionScope.sessionUser.name}"/> (<c:out value="${sessionScope.sessionUser.role}"/>)</span>
      <form method="post" action="${pageContext.request.contextPath}/logout" class="inline">
        <input type="hidden" name="csrf" value="${sessionScope.csrfToken}">
        <button class="link" type="submit">Log out</button>
      </form>
    </c:when>
    <c:otherwise>
      <a href="${pageContext.request.contextPath}/login">Log in</a>
      <a href="${pageContext.request.contextPath}/register">Register</a>
    </c:otherwise>
  </c:choose>
</nav></header>
<main>
<c:if test="${not empty sessionScope.flash}">
  <div class="notice"><c:out value="${sessionScope.flash}"/></div>
  <c:remove var="flash" scope="session"/>
</c:if>
<c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if>
