# Copy values into your shell or Tomcat's setenv.sh. Never commit real credentials.
VOTING_DB_URL=jdbc:mysql://localhost:3306/voting?useSSL=true&serverTimezone=UTC
VOTING_DB_USER=voting_app
VOTING_DB_PASSWORD=change-me
# First administrator (created once, only if no admin exists)
VOTING_ADMIN_EMAIL=admin@example.org
VOTING_ADMIN_PASSWORD=choose-a-long-passphrase
# true = in-memory demo with synthetic accounts (do not use with a real database)
VOTING_DEMO=false
